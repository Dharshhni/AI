)


# ==========================================
# SELECT QUESTION
# ==========================================

user_question = None

if voice_text:

    user_question = voice_text

elif text_question:

    user_question = text_question


# ==========================================
# PROCESS QUESTION
# ==========================================

if user_question:

    # Add user question
    st.session_state.messages.append(
        {
            "role": "user",
            "content": user_question
        }
    )

    with st.chat_message("user"):

        st.markdown(
            user_question
        )


    # ======================================
    # RAG RETRIEVAL
    # ======================================

    retrieved_docs = retrieve_documents(
        user_question,
        top_k=3
    )

    context = "\n\n".join(
        retrieved_docs
    )


    # ======================================
    # GEMINI RESPONSE
    # ======================================

    with st.chat_message("assistant"):

        with st.spinner(
            "✈️ Planning your trip..."
        ):

            answer = ask_gemini(
                user_question,
                context
            )

            st.markdown(
                answer
            )


            # ==================================
            # TEXT TO SPEECH
            # ==================================

            if not answer.startswith(
                "❌ Gemini Error"
            ):

                with st.spinner(
                    "🔊 Creating voice..."
                ):

                    audio_path = speak_answer(
                        answer
                    )

                if audio_path:

                    st.audio(
                        audio_path,
                        format="audio/mp3"
                    )

                else:

                    st.warning(
                        "⚠️ Voice output could not be generated."
                    )


    # ======================================
    # SAVE ASSISTANT RESPONSE
    # ======================================

    st.session_state.messages.append(
        {
            "role": "assistant",
            "content": answer
        }
    )

