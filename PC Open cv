import os
import time
import subprocess
import webbrowser
import datetime
from pathlib import Path
from urllib.parse import quote

import sounddevice as sd
import speech_recognition as sr
import pyttsx3


# =====================================
# AI VOICE COMPUTER CONTROLLER
# =====================================

SAMPLE_RATE = 16000
RECORD_SECONDS = 5

recognizer = sr.Recognizer()
speaker = pyttsx3.init()
speaker.setProperty("rate", 170)


def speak(message):
    print("Assistant:", message)
    speaker.say(message)
    speaker.runAndWait()


# =====================================
# FIND INSTALLED APPLICATIONS
# =====================================

def find_application(app_name):
    folders = [
        Path(os.environ.get("APPDATA", ""))
        / "Microsoft/Windows/Start Menu/Programs",

        Path(os.environ.get("PROGRAMDATA", ""))
        / "Microsoft/Windows/Start Menu/Programs"
    ]

    search_name = app_name.lower().strip()

    for folder in folders:
        if not folder.exists():
            continue

        try:
            for shortcut in folder.rglob("*.lnk"):
                shortcut_name = shortcut.stem.lower()

                if (
                    search_name == shortcut_name
                    or search_name in shortcut_name
                ):
                    return shortcut

        except (OSError, PermissionError):
            continue

    return None


