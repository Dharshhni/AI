    )


# =====================================
# OPEN FOLDERS
# =====================================

def open_folder(folder_name):
    folders = {
        "downloads": Path.home() / "Downloads",
        "documents": Path.home() / "Documents",
        "desktop": Path.home() / "Desktop",
        "pictures": Path.home() / "Pictures",
        "music": Path.home() / "Music",
        "videos": Path.home() / "Videos"
    }

    folder = folders.get(folder_name.lower().strip())

    if folder and folder.exists():
        os.startfile(str(folder))
        speak("Opening " + folder_name)
        return True

    return False


# =====================================
# PROCESS VOICE COMMANDS
# =====================================

def process_command(command):
    command = command.lower().strip()

    print("You said:", command)

    if not command:
        return True

    if command in [
        "stop", "exit", "quit",
        "stop assistant", "close assistant"
    ]:
        speak("Voice assistant stopped.")
        return False

    if command in ["help", "show commands"]:
        speak(
            "Say open followed by an application name. "
            "You can also say search for a topic, "
            "what time is it, or stop assistant."
        )
        return True

    if command.startswith("open "):
        target = command[5:].strip()

        if not open_folder(target):
            open_application(target)

        return True

    if command.startswith("search for "):
        query = command[len("search for "):].strip()

        webbrowser.open(
            "https://www.google.com/search?q=" + quote(query)
        )

        speak("Searching for " + query)
        return True

    if command.startswith("search "):
        query = command[len("search "):].strip()

        webbrowser.open(
            "https://www.google.com/search?q=" + quote(query)
        )

        speak("Searching for " + query)
        return True

    if "time" in command:
        current_time = datetime.datetime.now().strftime("%I:%M %p")
        speak("The time is " + current_time)
        return True

    if "date" in command or "today" in command:
        current_date = datetime.datetime.now().strftime("%d %B %Y")
        speak("Today's date is " + current_date)
        return True

    speak("Command not recognized. Say open followed by an application name.")
    return True


# =====================================
# LISTEN TO MICROPHONE
# =====================================

def listen():
    try:
        print("\nListening... Speak now.")

        recording = sd.rec(
            int(RECORD_SECONDS * SAMPLE_RATE),
            samplerate=SAMPLE_RATE,
            channels=1,
            dtype="int16"
        )

        sd.wait()

        audio = sr.AudioData(
            recording.tobytes(),
            SAMPLE_RATE,
            2
        )

        command = recognizer.recognize_google(
            audio,
            language="en-IN"
        )

        return command

    except sr.UnknownValueError:
        print("Sorry, I could not understand. Try again.")

    except sr.RequestError as error:
        print("Speech recognition error:", error)
        speak("Check your internet connection.")

    except Exception as error:
        print("Microphone error:", error)
        speak("Check your microphone permissions.")

    return ""


# =====================================
# MAIN PROGRAM
# =====================================

def main():
    speak(
        "AI Voice Computer Controller started. "
        "Say open followed by an application name."
    )

    while True:
        command = listen()

        if command:
            if not process_command(command):
                break

        time.sleep(0.3)


if __name__ == "__main__":
    main()
